# Qdrant Vector DB Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_CLUSTER_ENDPOINT=https://your-cluster-id.us-east-1-0.aws.cloud.qdrant.io:6333
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=evorag_chunks

# Cold Storage Archive Database (SQLite)
# COLD_STORAGE_DB_PATH=app/evorag_archive.db

# LLM Configuration (groq / openai)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL_NAME=llama-3.1-8b-instant

# Web Search Provider (tavily / serpapi)
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_api_key_here

# Embedding Model
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Retrieval & Evaluation Settings
CONFIDENCE_THRESHOLD=0.70
MAX_AGE_DAYS=30
RECENCY_KEYWORDS=latest,current,now,2026,today,recent,newest,update,present
CLASSIFICATION_MATCH_FLOOR=0.5

# Garbage Collection & Compaction Settings
MAX_VERSION_HISTORY=2
DUPLICATE_SIMILARITY_THRESHOLD=0.95
GC_INTERVAL_HOURS=24
